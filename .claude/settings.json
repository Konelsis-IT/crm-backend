{
  "permissions": {
    "deny": [
      "Bash(*artisan migrate*)",
      "Bash(*artisan db:wipe*)",
      "Bash(*artisan test*)",
      "Bash(*vendor/bin/pint*)",
      "Bash(*vendor\\bin\\pint*)",
      "Bash(*phpunit*)",
      "Bash(*pest*)",
      "Bash(composer setup*)",
      "Bash(composer run setup*)",
      "Bash(composer run-script setup*)",
      "Bash(composer test*)",
      "Bash(composer run test*)",
      "Bash(composer run-script test*)",
      "PowerShell(*artisan migrate*)",
      "PowerShell(*artisan db:wipe*)",
      "PowerShell(*artisan test*)",
      "PowerShell(*vendor/bin/pint*)",
      "PowerShell(*vendor\\bin\\pint*)",
      "PowerShell(*phpunit*)",
      "PowerShell(*pest*)",
      "PowerShell(composer setup*)",
      "PowerShell(composer run setup*)",
      "PowerShell(composer run-script setup*)",
      "PowerShell(composer test*)",
      "PowerShell(composer run test*)",
      "PowerShell(composer run-script test*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/guard-konelsis-command.ps1\""
          }
        ]
      }
    ]
  }
}
