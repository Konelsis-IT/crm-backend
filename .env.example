APP_NAME="Konelsis"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local skeleton only. Production/staging use MySQL 8.4 (see .env.production.example).
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=konelsis
# DB_USERNAME=konelsis_app
# DB_PASSWORD=
# DB_COLLATION=utf8mb4_0900_ai_ci
DB_TIMEZONE=+00:00

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Konelsis platform (docs/planning/16, docs/implementation/M01) ---
# Comma-separated SET of migration batch codes confirmed as applied by the DBA
# (e.g. B00,B01,B02,B08). Batches are not always authored/applied in
# alphabetical order, so this is a set, not a single "highest" value. Empty = no schema confirmed.
# Schema guard: migrations/seeds are refused unless the DBA sets the flags for that shell.
KONELSIS_SCHEMA_GUARD=true
KONELSIS_SCHEMA_CHANGES_ALLOWED=false
KONELSIS_DESTRUCTIVE_SCHEMA_ALLOWED=false
# First administrator personnel created by the bootstrap seeder.
# M03 RBAC (spatie/laravel-permission): the bootstrap admin above always
# gets the system_admin role. Comma-separated e-mails here get the auditor
# role too, but only once, when RoleSeeder runs — not read at runtime.
# Feature flags: personnel screens, Personel Hareketleri, Filament database notifications
FEATURE_PERSONNEL_ADMIN_UI=true
FEATURE_ACTIVITY_ADMIN_UI=true
FEATURE_DATABASE_NOTIFICATIONS=true
FEATURE_CHAT_UI=true
FEATURE_WORK_REQUESTS_UI=true
