# Konelsis staging environment template — same topology as production with
# anonymized data (docs/planning/01 §19 manual UAT).

APP_NAME="Konelsis (Staging)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://crm-staging.example.internal

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=konelsis_staging
DB_USERNAME=konelsis_app
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci
DB_TIMEZONE=+00:00

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply-staging@example.internal"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=konelsis-staging-private
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# --- Konelsis platform ---
KONELSIS_APPLIED_SCHEMA_BATCH=
KONELSIS_SCHEMA_GUARD=true
KONELSIS_SCHEMA_CHANGES_ALLOWED=false
KONELSIS_DESTRUCTIVE_SCHEMA_ALLOWED=false
KONELSIS_BOOTSTRAP_ADMIN_EMAIL=
KONELSIS_BOOTSTRAP_ADMIN_NAME="System Administrator"
KONELSIS_BOOTSTRAP_ADMIN_PASSWORD=
KONELSIS_SYSTEM_ADMIN_EMAILS=
KONELSIS_AUDITOR_EMAILS=
FEATURE_PERSONNEL_ADMIN_UI=true
FEATURE_ACTIVITY_ADMIN_UI=true
FEATURE_DATABASE_NOTIFICATIONS=true
