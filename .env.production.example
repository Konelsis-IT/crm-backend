# Konelsis production environment template (docs/planning/16 §2).
# Secrets are injected from the secret manager; never commit real values.

APP_NAME="Konelsis"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://crm.example.internal

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# MySQL 8.4 LTS / InnoDB / utf8mb4 — runtime role has no DDL privileges.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=konelsis
DB_USERNAME=konelsis_app
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci
DB_TIMEZONE=+00:00
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/mysql-ca.pem

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.internal"
MAIL_FROM_NAME="${APP_NAME}"

# Private, S3-compatible object storage (signed URLs only).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=konelsis-private
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# --- Konelsis platform ---
KONELSIS_APPLIED_SCHEMA_BATCH=
KONELSIS_SCHEMA_GUARD=true
KONELSIS_SCHEMA_CHANGES_ALLOWED=false
KONELSIS_DESTRUCTIVE_SCHEMA_ALLOWED=false
KONELSIS_BOOTSTRAP_ADMIN_EMAIL=
KONELSIS_BOOTSTRAP_ADMIN_NAME="System Administrator"
KONELSIS_BOOTSTRAP_ADMIN_PASSWORD=
KONELSIS_SYSTEM_ADMIN_EMAILS=
KONELSIS_AUDITOR_EMAILS=
FEATURE_PERSONNEL_ADMIN_UI=true
FEATURE_ACTIVITY_ADMIN_UI=true
FEATURE_DATABASE_NOTIFICATIONS=true
